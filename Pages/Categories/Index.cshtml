@page
@model GestionProduits.Pages.Categories.IndexModel
@{ ViewData["Title"] = "Catégories"; }

<h1>Liste des catégories</h1>

<div class="d-flex justify-content-end mb-3">
    <a asp-page="Create" class="btn btn-primary">+ Nouvelle catégorie</a>
</div>

<table class="table table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Nom</th>
            <th>Nombre de produits</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var c in Model.Categories)
    {
        <tr>
            <td>@c.Nom</td>
            <td>@c.Produits.Count</td>
            <td class="text-center">
                <a asp-page="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-warning">Modifier</a>
                <a asp-page="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-danger">Supprimer</a>
            </td>
        </tr>
    }
    </tbody>
</table>