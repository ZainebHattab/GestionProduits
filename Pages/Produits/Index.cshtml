@page
@model GestionProduits.Pages.Produits.IndexModel
@{ ViewData["Title"] = "Produits"; }

<h1>Liste des produits</h1>

<div class="d-flex justify-content-end mb-3">
    <a asp-page="Create" class="btn btn-primary">+ Nouveau produit</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input asp-for="Recherche" class="form-control" placeholder="Rechercher par nom" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Rechercher</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Réinitialiser</a>
    </div>
</form>

<table class="table table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Nom</th>
            <th>Prix</th>
            <th>Stock</th>
            <th>Catégorie</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model.Produits)
    {
        <tr>
            <td>@p.Nom</td>
            <td>@p.Prix.ToString("C")</td>
            <td>@p.Stock</td>
            <td>@p.Categorie?.Nom</td>
            <td class="text-center">
                <a asp-page="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Modifier</a>
                <a asp-page="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger">Supprimer</a>
            </td>
        </tr>
    }
    </tbody>
</table>